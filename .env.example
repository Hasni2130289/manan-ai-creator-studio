# Manan AI Creator Studio — environment variables
# ============================================================
# NEVER commit a real .env file. Copy this file to .env and fill
# in your own values. All secrets here are SERVER-SIDE ONLY —
# they must never be exposed to the browser or shipped in the
# frontend build.
# ============================================================

# Port the server listens on (Railway sets this automatically).
PORT=

# Environment: development | production
NODE_ENV=

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit a real value, and never reuse the value from another app.
JWT_SECRET=

# Optional — PostgreSQL connection string.
# When unset, the app uses its local JSON file store (server/data/).
DATABASE_URL=

# Email of the first admin account (created via the setup-admin endpoint).
ADMIN_EMAIL=

# Token required by the setup-admin endpoint to create the first admin.
# Generate a long random string; keep it private.
ADMIN_SETUP_TOKEN=

# Viral Research — YouTube Data API v3 key.
YOUTUBE_API_KEY=

# AI text / image / TTS provider (OpenAI).
OPENAI_API_KEY=

# Image generation provider key.
# Defaults to OPENAI_API_KEY when unset.
IMAGE_API_KEY=

# TTS narration provider (ElevenLabs).
ELEVENLABS_API_KEY=

# Speech-to-text provider key.
STT_API_KEY=

# Background removal provider key.
BGREMOVE_API_KEY=

# The existing Manan Clipping Tool is a SEPARATE app/repo and is
# linked from the Studio, not embedded. Default URL:
CLIPPING_TOOL_URL=https://manan-clipping-tool-production.up.railway.app/
